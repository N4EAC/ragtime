# Shared by the desktop bundle and the relocated real-codec test bundle.
# Opt-in, local artifacts only: configuring Ragtime never fetches codecs here.
function(ragtime_macos_sotto target)
    if(NOT RAGTIME_MACOS_SOTTO_DIR)
        return()
    endif()
    foreach(name libsotto.0.dylib libcodec2.1.2.dylib)
        set(file "${RAGTIME_MACOS_SOTTO_DIR}/${name}")
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "Missing ${file}; run packaging/macos/build-sotto.sh first")
        endif()
        target_sources(${target} PRIVATE "${file}")
        set_source_files_properties("${file}" PROPERTIES MACOSX_PACKAGE_LOCATION Frameworks)
    endforeach()
    foreach(name sotto.txt codec2.txt)
        set(file "${RAGTIME_MACOS_SOTTO_DIR}/licences/${name}")
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "Missing codec licence: ${file}")
        endif()
        target_sources(${target} PRIVATE "${file}")
        set_source_files_properties("${file}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources/licences)
    endforeach()
endfunction()
